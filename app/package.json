    "autoprefixer": "^10.4.19",
    "electron": "^37.2.5",
    "electron-builder": "^26.0.12",
    "electron-devtools-installer": "^3.2.0",
    "eslint": "^9.14.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.7",
    "generate-license-file": "^3.5.0",
    "globals": "^15.8.0",
    "jsdom": "^24.1.0",
