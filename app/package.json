    "color-convert": "^2.0.1",
    "color-string": "^2.0.1",
    "dotenv": "^16.4.5",
    "electron-log": "^5.1.5",
    "emoji-mart": "^5.6.0",
    "extract-zip": "^2.0.1",
    "font-list": "^2.0.0",
