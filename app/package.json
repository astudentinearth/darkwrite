{
  "name": "@darkwrite/app-desktop",
  "author": {
    "name": "astudentinearth",
    "email": "burak.yn.dev@gmail.com"
  },
  "description": "The eye candy note-taking app for all desktops.",
  "productName": "Darkwrite",
  "private": true,
  "version": "0.5.3-alpha.2",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "main": "dist-electron/main.js",
  "installConfig": {
    "hoistingLimits": "workspaces"
  },
  "scripts": {
    "dev": "vite",
    "build": "node ./darkwrite-builder.js",
    "preview": "vite preview",
    "build:pre": "npm-run-all --serial licenses build:vite",
    "build:vite": "vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "format": "prettier . --write",
    "test": "npm-run-all --serial rebuild:restore test:run",
    "test:run": "vitest run",
    "test:watch": "vitest watch",
    "coverage": "vitest run --coverage",
    "licenses": "generate-license-file --input package.json --output THIRDPARTY.txt --overwrite",
    "_postinstall": "electron-builder install-app-depsU",
    "install_app_deps": "electron-builder install-app-deps",
    "build:unpack": "yarn build:pre && electron-builder --dir",
    "build:electron:win": "electron-builder --win",
    "build:win": "npm-run-all --serial build:pre build:electron:win",
    "build:mac": "pnpm build:pre && electron-builder --mac",
    "build:linux": "pnpm build:pre && electron-builder --linux",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "rebuild:restore": "pnpm rebuild better-sqlite3",
    "typecheck": "tsc --noEmit --project tsconfig.json"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "@emoji-mart/data": "^1.2.1",
