{
  "name": "@darkwrite/app-desktop",
  "author": {
    "name": "astudentinearth",
    "email": "burak.yn.dev@gmail.com"
  },
  "description": "A notebook that is truly yours.",
  "homepage": "https://darkwrite.app",
  "productName": "Darkwrite",
  "private": true,
  "version": "1.1.0-beta.1",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "main": "dist-electron/main.js",
  "lint-staged": {
    "*.{ts,tsx,css,md}": "prettier --check"
  },
  "installConfig": {
    "hoistingLimits": "workspaces"
  },
  "scripts": {
    "dev": "vite",
    "build": "node ./darkwrite-builder.js",
    "preview": "vite preview",
    "build:pre": "npm-run-all --serial licenses build:vite",
    "build:vite": "vite build",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --check --write .",
    "test": "npm-run-all --serial rebuild:restore test:run",
    "test:run": "vitest run",
    "test:watch": "vitest watch",
    "coverage": "vitest run --coverage",
    "licenses": "license-checker-rseidelsohn --plainVertical --out THIRDPARTY.txt --production --excludePrivatePackages",
    "_postinstall": "electron-builder install-app-deps",
    "install_app_deps": "electron-builder install-app-deps",
    "build:electron:win": "electron-builder --win",
    "build:win": "npm-run-all --serial build:pre build:electron:win",
    "build:mac": "pnpm build:pre && electron-builder --mac",
    "build:linux": "pnpm build:pre && electron-builder --linux",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "rebuild:restore": "pnpm rebuild better-sqlite3",
    "typecheck": "tsc --noEmit --project tsconfig.json"
  },
