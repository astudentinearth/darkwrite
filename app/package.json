    "novel": "^0.5.0",
    "react": "^19",
    "react-colorful": "^5.6.1",
    "react-dom": "^19",
    "react-i18next": "^15.5.1",
    "react-resizable-panels": "^2.1.7",
    "react-router-dom": "^7.5.3",
    "reflect-metadata": "^0.2.2",
