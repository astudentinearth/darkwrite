{
  "preloadScriptPath": "preload.js",
  "webcontentsUrl": "../dist/index.html",
  "websiteUrl": "https://darkwrite.app",
  "documentationUrl": "https://darkwrite.app/docs",
  "reportBugsUrl": "https://github.com/astudentinearth/darkwrite/issues",
  "icons": {
    "development": "../resources/darkwrite_icon.png"
  },
  "windowDefaults": {
    "width": 1000,
    "height": 700,
    "titleBarOverlay": {
      "color": "#13131300",
      "symbolColor": "#ffffff",
      "height": 48
    }
  },
  "pathConfig": {
    "dir": {
      "data": {
        "development": "darkwrite-data-nightly/",
        "production": "darkwrite-data/"
      },
      "backup": "darkwrite-data-old/",
      "documentStore": "notes/",
      "cache": {
        "exporter": "dw-html-export/",
        "backup": "dw-backup/",
        "restore": "dw-restore/"
      },
      "theme": "themes/",
      "blob": "embeds/",
      "session": {
        "development": "session-dev/",
        "production": "session/"
      },
      "migration": "dw-migration/"
    },
    "settingsFile": "settings.json",
    "dbFile": "darkwrite.db"
  }
}
