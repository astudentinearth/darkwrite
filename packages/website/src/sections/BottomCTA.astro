---
import DownloadButton from "../components/DownloadButton.astro";
---

<section class="max-w-320 w-full mt-3 flex flex-col items-center gap-24 px-6">
  <div
    class="flex flex-col w-full items-center text-center gap-4 bg-card [&_p]:text-xl hover:brightness-120 border rounded-3xl drop-shadow-xl p-6 pt-24 pb-18"
  >
    <h1 class="text-4xl md:text-[64px] font-bold">
      Get started and make it yours.
    </h1>
    <p class="text-white/80 max-w-96 text-2xl">
      Download the app for free and start writing in peace - without
      disruptions.
    </p>
    <div class="h-4"></div>
    <DownloadButton />
  </div>
</section>
