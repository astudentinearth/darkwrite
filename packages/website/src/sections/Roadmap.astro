---
import { Markdown } from 'simple-icons-astro';
import RoadmapItem from '../components/RoadmapItem.astro';
import {TableProperties, Milestone, BookText, Server, Package, Network, Blocks, FolderTree, Table} from "@lucide/astro"
---

<div id="roadmap" class="gap-12 flex flex-col max-w-360 w-full mt-32 px-6 xl:px-0">
  <h1>Roadmap</h1>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-8 type-body md:type-body-lg [&_h2]:opacity-85 md:[&_svg]:size-6 [&_svg]:size-4">
    <div class="flex flex-col gap-2 md:gap-3">
      <h2 class="mb-2 pl-1">Released</h2>
      <RoadmapItem>
        <TableProperties />
        <span>Custom properties</span>
      </RoadmapItem>
      <RoadmapItem>
        <Markdown />
        <span>Markdown export</span>
      </RoadmapItem>
    </div>
    <div class="flex flex-col gap-2 md:gap-3">
      <h2 class="mb-2">In development</h2>
      <RoadmapItem>
        <Table />
        <span>Databases</span>
      </RoadmapItem>
      <RoadmapItem>
        <FolderTree />
        <span>Storage rework</span>
      </RoadmapItem>
    </div>
    <div class="flex flex-col gap-2 md:gap-3">
      <h2 class="mb-2">Planned</h2>
      <RoadmapItem>
        <Server />
        <span>Self-hosted sync</span>
      </RoadmapItem>
      <RoadmapItem>
        <Package />
        <span>Flatpak support</span>
      </RoadmapItem>
      <RoadmapItem>
        <Network />
        <span>Graph view</span>
      </RoadmapItem>
      <RoadmapItem>
        <Blocks />
        <span>Plugin API</span>
      </RoadmapItem>
    </div>
  </div>
</div>
