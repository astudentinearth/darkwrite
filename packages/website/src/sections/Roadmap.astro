---
import RoadmapItem from '../components/RoadmapItem.astro';
import {TableProperties, Milestone, BookText, Server, Package, Network, Blocks} from "@lucide/astro"
---

<div id="roadmap" class="gap-12 flex flex-col max-w-360 w-full mt-32 px-6 xl:px-0">
  <h1>Roadmap</h1>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-12 type-body md:type-body-lg">
    <div class="flex flex-col gap-3 md:gap-4">
      <h2 class="mb-2">In development</h2>
      <RoadmapItem>
        <TableProperties />
        <span>Databases</span>
      </RoadmapItem>
      <RoadmapItem>
        <Milestone />
        <span>v1.2 milestone tasks on GitHub</span>
      </RoadmapItem>
      <RoadmapItem>
        <BookText />
        <span>User documentation</span>
      </RoadmapItem>
    </div>
    <div class="flex flex-col gap-3 md:gap-4">
      <h2 class="mb-2">Planned</h2>
      <RoadmapItem>
        <Server />
        <span>Collaboration &amp; sync server (self hosted)</span>
      </RoadmapItem>
      <RoadmapItem>
        <Package />
        <span>Flatpak support</span>
      </RoadmapItem>
      <RoadmapItem>
        <Network />
        <span>Graph view</span>
      </RoadmapItem>
      <RoadmapItem>
        <Blocks />
        <span>Plugin API</span>
      </RoadmapItem>
    </div>
  </div>
</div>
