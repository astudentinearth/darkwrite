const features = [
  {
    title: 'Easy-to-use editor',
    description: 'Everything you’d expect to create beautiful docs, ready at your disposal.',
    image: '/editor.webp',
    alt: 'Screenshot of core editor features',
  },
  {
    title: 'Infinitely customizable',
    description: 'From individual notes to the entire UI, tweak the look and feel to your vibe.',
    image: '/colors.webp',
    alt: 'Screenshot of note styling features',
  },
  {
    title: 'One-click backups',
    description: 'Pack everything up into a archive, restore with one click on a new device.',
    image: '/backup.webp',
    alt: 'Backup feature buttons',
  },
  {
    title: 'Themes and fonts',
    description:
      'Use one of the included themes or make your own. Export PDFs with custom fonts and colors, without hassle.',
