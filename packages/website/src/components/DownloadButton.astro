---
import { Download } from "@lucide/astro";
import { cn, type ClassProp } from "../lib/utils";

interface Props extends ClassProp {}
---

<a
  href="/downloads"
  class={cn(
  // the cursed paddings are for visual balance
    "bg-primary text-white text-xl leading-8 tracking-[-0.04em] cursor-pointer hover:brightness-110 flex items-center gap-2 transition-[filter] duration-75 pl-[19px] py-3 pr-5 drop-shadow-md hover:drop-shadow-lg drop-shadow-primary/20 rounded-2xl top-highlight-highlight",
    Astro.props.class,
  )}
>
  <Download />
  <span class="hero-download-button">Get Darkwrite</span>
</a>
