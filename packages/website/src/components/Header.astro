---
import { GIT_REPO_URL } from "../lib/resources";
import Darkwrite from "./Darkwrite.astro";
---

<header
  class="fixed left-0 right-0 h-18 p-4 z-50 backdrop-blur-md flex type-body text-muted-foreground justify-center items-center text-xl"
>
  <div class="max-w-360 w-full lg:px-12 flex items-center">
    <a class="flex logo shrink-0 items-center gap-3" href="/">
      <Darkwrite class="size-10" />
      <span class="font-medium text-xl text-foreground">Darkwrite</span>
    </a>
    <div class="grow"></div>
    <a href="/docs">Docs</a>
    <a href={GIT_REPO_URL}>GitHub</a>
    <a href="/downloads">Get started</a>
  </div>
</header>
