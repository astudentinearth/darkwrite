---
import Meta from "../components/Meta.astro";
import DefaultLayout from "../layouts/DefaultLayout.astro";
import BottomCTA from "../sections/BottomCTA.astro";
import Cards from "../sections/Cards.astro";
import Hero from "../sections/Hero.astro";
import Sections from "../sections/Sections.astro";
import AfterHero from "../sections/AfterHero.astro";
---

<DefaultLayout>
  <Meta title="Darkwrite | A notebook that is truly yours" />
  <div class="w-full flex flex-col items-center overflow-x-hidden">
    <Hero />
    <hr class="mt-24 md:mt-48 mb-18 md:mb-32"/>
    <AfterHero />
    <Sections />
    <Cards />
    <BottomCTA />
    <div class="h-12"></div>
  </div>

  <script>
    import { getOperatingSystem } from "../lib/platform";
    const os = getOperatingSystem();
    if (os !== "Other") {
      const buttons = document.querySelectorAll(".hero-download-button");
      buttons.forEach((btn) => {
        if (btn instanceof HTMLElement)
          btn.innerText = `Download for ${os}`;
      });
    }
  </script>
</DefaultLayout>
