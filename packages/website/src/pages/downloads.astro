---
import DefaultLayout from "../layouts/DefaultLayout.astro";
import { Grid2x2, Code } from "@lucide/astro";
import Linux from "simple-icons-astro/Linux";
import Apple from "simple-icons-astro/Apple";
import {
  LINUX_LATEST_RELEASE,
  WINDOWS_LATEST_RELEASE,
  AUR_PACKAGE_URL,
  MACOS_LATEST_RELEASE,
  GIT_REPO_URL,
  RELEASE_PAGE_URL,
  UBUNTU_LATEST_RELEASE,
} from "../lib/resources";
import Darkwrite from "../components/Darkwrite.astro";
import DownloadButton from "../components/DownloadButton.astro";
import Meta from "../components/Meta.astro";
---

<DefaultLayout>
  <Meta title="Downloads | Darkwrite" />
  <main class="mt-40 pb-12 w-full flex flex-col items-center text-foreground">
    <div
      class="max-w-320 w-full px-4 flex flex-col gap-4 [&_h2]:font-semibold [&_h2]:text-3xl [&_h2]:md:text-4xl"
      >
      <div class="flex flex-col items-center gap-6">
        <div class="logo">
          <Darkwrite class="size-20 md:size-28" />
          </div>
      <h1 class="text-3xl md:text-5xl font-bold">Get started</h1>
      </div>
      <div class="h-4"></div>
      <div
        class="flex flex-col md:flex-row gap-4 mt-4 [&>div>div]:hover:brightness-125"
        >
        <div class="w-full flex flex-col gap-4">
        <div class="p-4 bg-view-1 top-highlight-reflection rounded-xl flex flex-col gap-3">
          <h2 class="flex items-center gap-2"><Grid2x2 size={32} />Windows</h2>
          <a href={WINDOWS_LATEST_RELEASE}>Download the installer</a>
          <hr />
          <p class="text-muted-foreground">
            If you see a Windows Defender/SmartScreen warning when you run the
            installer, choose <strong>&apos;More info&apos;</strong>, then <strong
              >&apos;Run Anyway&apos;.</strong
            > The warning is present because we can&apos;t sign our builds yet.
          </p>
        </div> 
        <div class="p-4 bg-view-1 top-highlight-reflection rounded-xl flex flex-col gap-3">
          <h2 class="flex items-center gap-2"><Apple /> macOS</h2>
          <a href={MACOS_LATEST_RELEASE}>Download the installer (DMG)</a>
          Once you have the installer downloaded, just drag Darkwrite to your Applications folder.
        </div>
        </div>
        <div class="w-full flex flex-col gap-4">
        <div class="p-4 bg-view-1 top-highlight-reflection rounded-xl flex flex-col gap-3">
          <h2 class="flex items-center gap-2"><Linux /> Linux</h2><a
            href={LINUX_LATEST_RELEASE}>Download the AppImage</a
          >
          <hr />
          <h3 class="font-semibold">Ubuntu</h3>
          <a href={UBUNTU_LATEST_RELEASE}>Download the .deb package</a>
          <hr/>
          <h3 class="font-semibold">Arch-based distributions</h3>
          <p>
            You can use the unofficial <a href={AUR_PACKAGE_URL}>AUR package.</a
            >
          </p>
          <code>yay -S darkwrite-bin</code>
        </div>

        <div class="p-4 bg-view-1 top-highlight-reflection rounded-xl flex flex-col gap-3 h-fit">
          <h2 class="flex items-center gap-2">
            <Code size={32} class="shrink-0" /> Source code and other releases
          </h2>
          <a href={GIT_REPO_URL}>Git repository</a>
          <a href={RELEASE_PAGE_URL}>All releases on GitHub</a>
        </div>
        </div>
      </div>
    </div>
  </main>
</DefaultLayout>

<style>
  a {
    color: var(--primary);
    filter: brightness(200%);
  }
  a:hover {
    text-decoration: underline;
  }

  .logo {
    filter: drop-shadow(0 2px 12px oklch(39.4% 0.059704 257 / 0.5));
    transition: filter, transform 0.2s ease-in-out;
  }
  .logo:hover {
    filter: drop-shadow(0 2px 12px oklch(39.4% 0.059704 257 / 0.6));
    transform:scale(1.02);
  }
</style>
