---
import Meta from "../../components/Meta.astro";
import DocsLayout from "../../layouts/DocsLayout.astro";
import { GIT_REPO_URL } from "../../lib/resources";
import LinkCard from "../../components/docs/LinkCard.astro";
import {Download, Code} from "@lucide/astro";
---

<DocsLayout>
  <Meta title="Docs | Darkwrite" />
  <main class="flex flex-col gap-3">
    <h1>User guide</h1>
    <p>
      Welcome to Darkwrite&apos;s user documentation. We&apos;ll be adding new
      pages here as we move forward, until then you can check these out:
    </p>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3 mt-2">
      <LinkCard href="/docs/installation">
        <span slot="icon"><Download class="size-4"/> </span>
        <span slot="title">Installation guide</span>
        <p slot="description">Get help with installing Darkwrite</p>
      </LinkCard>
      <LinkCard href={GIT_REPO_URL}>
        <span slot="icon"><Code class="size-4"/> </span>
        <span slot="title">Source code</span>
        <p slot="description">Our GitHub repository</p>
      </LinkCard>
    </div>
    <img src="/hero_screenshot.webp" class="mt-4 hero-screenshot" />
  </main>
</DocsLayout>
<style>
  .hero-screenshot {
    filter: drop-shadow(0 0 1px var(--border));
  }
</style>
