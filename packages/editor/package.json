{
  "name": "@darkwrite/editor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/editor.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/editor.css"
  ],
  "scripts": {
    "dev": "vite",
    "dev:lib": "run-p vite:watch css:watch",
    "build": "npm-run-all --serial build:tsc build:vite build:css",
    "lint": "eslint .",
    "preview": "vite preview",
    "build:vite": "vite build",
    "vite:watch": "vite build --watch",
    "build:css": "tailwindcss -i ./src/globals.css -o ./dist/styles.css",
    "css:watch": "tailwindcss -i ./src/globals.css -o ./dist/styles.css --watch",
    "build:tsc": "tsc -b ./tsconfig.app.json"
  },
  "dependencies": {
    "@darkwrite/common": "workspace:*",
    "@darkwrite/ui": "workspace:*",
    "@tailwindcss/typography": "^0.5.16",
    "@tiptap/core": "^2.11.9",
    "@tiptap/extension-bubble-menu": "^2.11.9",
    "@tiptap/extension-code-block-lowlight": "^2.12.0",
    "@tiptap/extension-color": "^2.24.1",
    "@tiptap/extension-horizontal-rule": "^2.11.9",
    "@tiptap/extension-image": "^2.12.0",
    "@tiptap/extension-link": "^2.11.9",
    "@tiptap/extension-placeholder": "^2.11.9",
    "@tiptap/extension-task-item": "^2.11.9",
    "@tiptap/extension-task-list": "^2.11.9",
    "@tiptap/extension-text-style": "^2.24.1",
    "@tiptap/extension-underline": "^2.11.9",
    "@tiptap/html": "^2.11.9",
    "@tiptap/pm": "^2.11.9",
    "@tiptap/react": "^2.11.9",
    "@tiptap/starter-kit": "^2.11.9",
    "@tiptap/suggestion": "^2.11.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^25.1.3",
    "lowlight": "^3.3.0",
    "lucide-react": "^0.507.0",
    "nanoid": "^5.1.5",
    "prosemirror-state": "^1.4.3",
    "prosemirror-view": "^1.39.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^15.5.1",
    "tailwind-merge": "^3.2.0",
    "tailwindcss-animate": "^1.0.7",
    "tippy.js": "^6.3.7",
    "tiptap-extension-auto-joiner": "^0.1.3",
    "tiptap-extension-global-drag-handle": "^0.1.18"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@tailwindcss/cli": "^4.1.7",
    "@tailwindcss/vite": "^4.1.5",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^9.19.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "globals": "^15.14.0",
    "npm-run-all": "^4.1.5",
    "tailwindcss": "^4.1.5",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.22.0",
    "vite": "^6.3.4",
    "vite-plugin-dts": "^4.5.4"
  }
}
