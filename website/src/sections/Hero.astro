---
import { Download, Star } from "@lucide/astro";
import DownloadButton from "../components/DownloadButton.astro";
import { GIT_REPO_URL } from "../lib/resources";
---

<div class="max-w-320 w-full mt-48 flex flex-col items-center gap-2 px-4">
  <h1 class="text-5xl md:text-[64px] font-bold text-center">
    A notebook that is <span
      class="bg-clip-text bg-linear-to-r text-transparent from-[#338BFF] to-[#79A3DB]"
      >truly yours.</span
    >
  </h1>
  <p class="text-center inline-block max-w-180 mt-4">
    The personal workspace that respects you. <span class="text-primary-text"
      >Feature packed, customizable and open source.</span
    >
  </p>
  <DownloadButton class="mt-8" />
  <div
    class="text-white/70 flex items-center gap-2 text-sm sm:text-lg mt-2 *:flex *:gap-1 *:items-center"
  >
    <a class="text-white/70!" href={GIT_REPO_URL}
      ><Star size={18} /> 200+ stars on GitHub</a
    >
  </div>
  <!-- <a
    class="text-white/70 flex mt-2 text-[18px] hover:underline"
    href="/downloads">Other downloads</a
  > -->
  <div class="w-fit px-4">
    <img
      src="/hero.webp"
      class="border rounded-lg max-w-400 mt-16 drop-shadow-2xl w-full"
    />
  </div>
</div>
