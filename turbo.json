{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "dist-electron/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "lint": {
      "outputs": [],
      "dependsOn": ["^build"]
    },
    "format": {
      "outputs": []
    },
    "check": {
      "dependsOn": ["^build", "^typecheck", "^lint"],
      "outputs": []
    }
  }
}
